{
  "server": {
    "host": "127.0.0.1",
    "port": 1934,
    "auth_mode": "api_key",
    "root_api_key": "<your-root-api-key>",
    "cors_origins": ["*"],
    "observability": {
      "metrics": {
        "enabled": true
      }
    }
  },
  "storage": {
    "workspace": "./data",
    "vectordb": {
      "name": "context",
      "backend": "local",
      "project": "default"
    }
  },
  "embedding": {
    "dense": {
      "provider": "volcengine",
      "api_key": "<your-ark-api-key>",
      "model": "doubao-embedding-vision",
      "api_base": "https://ark.cn-beijing.volces.com/api/plan/v3",
      "dimension": 1024,
      "input": "multimodal"
    },
    "allow_metadata_override": true
  },
  "vlm": {
    "provider": "volcengine",
    "model": "doubao-seed-2.1-lite",
    "api_base": "https://ark.cn-beijing.volces.com/api/plan/v3",
    "temperature": 0.0,
    "max_retries": 2,
    "api_key": "<your-ark-api-key>",
    "thinking": false
  },
  "rules": {
    "compiler": {
      "provider": "volcengine",
      "model": "doubao-seed-2.1-pro",
      "api_base": "https://ark.cn-beijing.volces.com/api/plan/v3",
      "api_key": "<your-ark-api-key>",
      "temperature": 0.0,
      "thinking": true,
      "max_retries": 2
    },
    "compiler_context_window": 32768
  },
  "output_language_override": "zh-CN",
  "log": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "output": "stdout"
  },
  "encryption": {
    "api_key_hashing": {
      "enabled": true
    }
  }
}
