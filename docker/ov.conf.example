{
  "server": {
    "host": "127.0.0.1",
    "port": 1934,
    "auth_mode": "api_key",
    "root_api_key": "<your-root-api-key>",
    "cors_origins": ["*"]
  },
  "storage": {
    "workspace": "./data",
    "vectordb": {
      "name": "context",
      "backend": "local",
      "project": "default"
    }
  },
  "embedding": {
    "dense": {
      "provider": "volcengine",
      "api_key": "<your-ark-api-key>",
      "model": "doubao-embedding-vision",
      "api_base": "https://ark.cn-beijing.volces.com/api/plan/v3",
      "dimension": 1024,
      "input": "multimodal"
    },
    "allow_metadata_override": true
  },
  "vlm": {
    "provider": "volcengine",
    "model": "ark-code-latest",
    "api_base": "https://ark.cn-beijing.volces.com/api/plan/v3",
    "temperature": 0.0,
    "max_retries": 2,
    "api_key": "<your-ark-api-key>"
  },
  "log": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "output": "stdout"
  }
}
